# ---- Providers -------------------------------------------------------------
# Embeddings: hashing (offline, deterministic) | openai | ollama
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512

# Answer generation: extractive (offline) | openai | anthropic | ollama
LLM_PROVIDER=extractive
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Vector store: memory | milvus
VECTOR_STORE=memory
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=docsearch_chunks

# Retrieval
TOP_K=4
MIN_SCORE=0.15

# ---- Secrets (never commit real values) ------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
